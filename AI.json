      "actionName": "setHeading",
      "description": "Set the heading level.",
      "args": [
        {
          "name": "level",
          "type": "number",
          "description": "Heading level 1-6."
        }
      ]
    },
    {
      "label": "Set text color",
      "actionName": "setColor",
      "description": "Apply a text color.",
      "args": [
        {
          "name": "color",
          "type": "string",
          "description": "Hex or CSS color."
        }
      ]
    },
    {
      "label": "Clear text color",
      "actionName": "unsetColor",
      "description": "Remove the text color."
    },
    {
      "label": "Set font family",
      "actionName": "setFontFamily",
      "description": "Apply a font family.",
      "args": [
        {
          "name": "family",
          "type": "string",
          "description": "Font family name."
        }
      ]
    },
    {
      "label": "Set link",
      "actionName": "setLink",
      "description": "Add or update a link.",
      "args": [
        {
          "name": "href",
