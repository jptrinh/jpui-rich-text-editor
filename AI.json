{
  "metadata": {
    "name": "jpui-rich-text-editor",
    "description": "A TipTap-based rich text editor whose formatting toolbar is a floating dropzone shown on text selection; buttons dropped inside are wired to the editor actions.",
    "keywords": [
      "rich text",
      "editor",
      "wysiwyg",
      "tiptap",
      "toolbar",
      "bubble menu"
    ],
    "features": [
      "Floating selection toolbar built as a customizable dropzone",
      "Formatting actions: bold, italic, underline, strike, headings, lists, quote, code, color, font, link",
      "Smart menu placement with auto-flip and offset controls",
      "Live selection state exposed for active-state buttons",
      "HTML value output and change/focus/blur/selectionChange events"
    ],
    "inherit": []
  },
  "properties": [
