  "states": [],
  "events": [
    {
      "name": "change",
      "description": "Fires when the content changes.",
      "payload": {
        "value": "HTML string"
      }
    },
    {
      "name": "focus",
      "description": "Fires when the editor gains focus.",
      "payload": {}
    },
    {
      "name": "blur",
      "description": "Fires when the editor loses focus.",
      "payload": {}
    },
    {
      "name": "selectionChange",
      "description": "Fires when the selection changes.",
      "payload": {
        "text": "selected text"
      }
    }
  ],
  "localContext": [
    {
      "name": "richText",
      "description": "Live editor/selection state, available to elements inside the toolbar dropzone (and other descendants) as context.local.data['richText']. Updates on every selection and content change.",
      "properties": [
        {
          "name": "isBold",
          "type": "boolean",
          "description": "True when the selection is bold."
        },
        {
          "name": "isItalic",
          "type": "boolean",
          "description": "True when the selection is italic."
        },
        {
          "name": "isUnderline",
          "type": "boolean",
          "description": "True when the selection is underlined."
        },
        {
          "name": "isStrike",
          "type": "boolean",
          "description": "True when the selection is struck through."
        },
        {
          "name": "isCode",
          "type": "boolean",
          "description": "True when the selection is inline code."
        },
        {
          "name": "isCodeBlock",
          "type": "boolean",
          "description": "True when the block is a code block."
        },
        {
          "name": "isBulletList",
          "type": "boolean",
          "description": "True when in a bullet list."
        },
        {
          "name": "isOrderedList",
          "type": "boolean",
          "description": "True when in an ordered list."
        },
        {
          "name": "isBlockquote",
          "type": "boolean",
          "description": "True when in a blockquote."
        },
        {
          "name": "isLink",
          "type": "boolean",
          "description": "True when the selection is a link."
        },
        {
          "name": "currentHeadingLevel",
          "type": "number",
          "description": "Heading level of the block (0 = paragraph)."
        },
        {
          "name": "currentColor",
          "type": "string",
          "description": "Current text color, or null."
        },
        {
          "name": "currentFontFamily",
          "type": "string",
          "description": "Current font family, or null."
        },
        {
          "name": "linkHref",
          "type": "string",
          "description": "Href of the current link, or null."
        },
        {
          "name": "hasSelection",
          "type": "boolean",
          "description": "True when there is a non-empty selection."
        },
        {
          "name": "selectedText",
          "type": "string",
          "description": "The currently selected text."
        },
        {
          "name": "isEmpty",
          "type": "boolean",
          "description": "True when the editor is empty."
        },
        {
          "name": "html",
          "type": "string",
          "description": "Current content as HTML."
        }
      ]
    }
  ],
