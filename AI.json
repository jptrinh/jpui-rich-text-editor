          "description": "Link URL."
        }
      ]
    },
    {
      "label": "Remove link",
      "actionName": "unsetLink",
      "description": "Remove the link."
    },
    {
      "label": "Clear formatting",
      "actionName": "clearFormatting",
      "description": "Remove all formatting."
    },
    {
      "label": "Focus editor",
      "actionName": "focus",
      "description": "Focus the editor."
    },
    {
      "label": "Close toolbar",
      "actionName": "closeToolbar",
      "description": "Hide the floating toolbar until the next selection."
    }
  ],
  "slots": [
    {
      "name": "toolbarContent",
      "description": "Dropzone for the floating selection toolbar. Drop buttons/icons here and wire each to one of the component actions; read context.local.data['richText'] (or the \"state\" variable) to show active states.",
      "type": "element"
    }
  ],
  "variables": [
    {
      "name": "value",
      "description": "Current content as HTML.",
      "type": "string",
      "readonly": false
    },
    {
      "name": "state",
      "description": "Live formatting state of the current selection (same fields as the richText local context).",
      "type": "object",
      "readonly": true
    }
  ],
  "specifications": [
    "The formatting toolbar is not built in: drop your own buttons into the toolbarContent dropzone and wire them to the actions.",
    "The floating menu appears on text selection; in the WeWeb editor it stays open when forceOpenMenu is on so you can arrange buttons.",
    "Selection state is exposed twice: context.local.data['richText'] (instance-relative, for elements inside the dropzone) and the global \"state\" variable (variables['<uid>-state']).",
    "Output is HTML via the \"value\" variable and the change event.",
    "Per-element-type typography is controlled by the style properties grouped by element (Paragraph, Heading 1-6, Quote, Code, Lists, Link)."
  ],
  "examples": [
    {
      "description": "Minimal editor with a starting value",
      "example": "{\"initialValue\": \"<p>Hello</p>\", \"editable\": true}"
    }
  ],
  "dependencies": []
}
